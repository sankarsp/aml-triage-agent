# Local development (docker compose sets these for you)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aml

# "mock" runs fully offline. Switch both to "bedrock" once you have AWS credentials
# and Bedrock model access enabled in your region.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# Triage policy
HISTORY_DAYS=90
FORCE_ESCALATE_SCORE=70
AUTO_CLOSE_MAX_SCORE=-1
HIGH_RISK_COUNTRIES=KP,IR,MM

# Optional: require X-API-Key on every request
# API_KEY=change-me
